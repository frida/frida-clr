<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Frida</RootNamespace>
    <PackageId>Frida.NET</PackageId>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Frida Developers</Authors>
    <PackageProjectUrl>https://github.com/frida/frida-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/frida/frida-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Frida.NET.Bindings\Frida.NET.Bindings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="meson.build" />
  </ItemGroup>

  <ItemGroup>
    <RuntimePackageRid Include="win-x86;win-x64;osx-x64;osx-arm64;linux-x86;linux-x64;linux-arm32;linux-arm64;linux-mips64" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackRuntimeManifest</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="PackRuntimeManifest">
    <PropertyGroup>
      <RuntimeManifestEntries>@(RuntimePackageRid->'&quot;%(Identity)&quot;:{&quot;Frida.NET&quot;:{&quot;Frida.NET.Runtime.%(Identity)&quot;:&quot;$(PackageVersion)&quot;}}', ',')</RuntimeManifestEntries>
      <RuntimeManifestPath>$(IntermediateOutputPath)runtime.json</RuntimeManifestPath>
    </PropertyGroup>
    <WriteLinesToFile File="$(RuntimeManifestPath)" Lines="{&quot;runtimes&quot;:{$(RuntimeManifestEntries)}}" Overwrite="true" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(RuntimeManifestPath)">
        <PackagePath>runtime.json</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
